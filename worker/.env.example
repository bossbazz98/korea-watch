# Copy to .env on your iMac. Never commit .env or private keys.
# Keep the service account JSON outside this repository.
FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/service-account.json
# Add the keys you actually use; one AI provider is enough.
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional GitHub Models/reporting credentials. Leave empty for local-only checks.
GITHUB_TOKEN=
GITHUB_REPOSITORY=
APP_URL=https://korea-watch01.web.app
# Keep the existing Korean-day accounting unless your provider reset requires another zone.
AI_QUOTA_TIMEZONE=Asia/Seoul
